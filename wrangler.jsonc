{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ammmaa-repo",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "ammmaa", "database_id": "2147543a-b9a2-4455-a129-55555f54ed88" }
  ],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["* * * * *", "0 21 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "VAPID_PUBLIC_KEY": "BLqhl7Ffr-lNNq9P9YgHD0qgSbrhn-ZidfmaGOxH-9z6ccKdYxlZzu9ZK1Lf8imAB30mPhWJDHf47ldKUr59ZoU",
    "VAPID_SUBJECT": "mailto:you@example.com",
    "AI_VARIATIONS": "off"
  }
}
